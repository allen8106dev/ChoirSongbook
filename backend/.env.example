# Choir Songbook Backend Configuration

# General Settings
PROJECT_NAME="Choir Songbook Backend"
DEBUG=true
API_V1_STR="/api"

# Security (JWT token generation)
# Generate a secure secret using: openssl rand -hex 32
JWT_SECRET="54ef1394cbeee97c9b0e2ad05a8120d82998394aef47bf841ef9059f1348be22"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Local SQLite fallback
DATABASE_URL="sqlite:///./choir_songbook.db"
# PostgreSQL/Supabase Example (for production):
# DATABASE_URL="postgresql://postgres:password@db.supabase.co:5432/postgres"

# Google Authentication
GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID_HERE"

# Storage Configuration
# Options: "local" or "supabase"
STORAGE_PROVIDER="local"
UPLOAD_DIR="uploads"

# Supabase Storage Configuration (for production)
SUPABASE_URL=""
SUPABASE_KEY=""
SUPABASE_BUCKET="song-audio"
